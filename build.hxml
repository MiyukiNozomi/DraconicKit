-D draconicbuilder
--dce no
--java-lib ../../lib/rhino.jar
--cwd packages/core
--class-path src
--macro nullSafety("shinku", Strict)
--main DevMain
--library haxe-concurrent
--xml ../../bin/shinku-project-symbols.xml
--jvm ../../bin/DraconicKit.jar

--next
-dce full
-D js-es=6
--class-path packages/shinkujs/src
--main Shinku
--js bin/shinku.js